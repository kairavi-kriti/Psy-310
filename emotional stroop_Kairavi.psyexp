                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="Welcome to the experiment!&#10;&#10;You will see words displayed in different colours.&#10;&#10;Your task is to identify the colour of each word as quickly and accurately as possible. Ignore the meaning of the word.&#10;&#10;Press:ok done&#10;R for Red&#10;Y for Yellow&#10;B for Blue&#10;G for Green&#10;&#10;Try to respond as quickly and accurately as possible.&#10;&#10;Press SPACE to begin." valType="str" updates="constant" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
